<?xml version="1.0" encoding="utf-8"?>
<!--~
    单文件发布配置（ticket 13）。
    一条命令发布：dotnet publish src/GitHarvest/GitHarvest.csproj -c Release -p:PublishProfile=single-file
    产物：src/GitHarvest/bin/Release/net9.0-windows/win-x64/publish/GitHarvest.exe（self-contained，目标机器无需安装 .NET）。

    - PublishSingleFile + SelfContained + win-x64：spec 的发布形态（「解决方案与发布」节）。
    - EnableCompressionInSingleFile：压缩托管程序集，单文件体积约为不压缩的一半；
      代价是首次启动解压稍慢（启动耗时以日志的「主窗口已显示」行记录，作为基线）。
    - IncludeNativeLibrariesForSelfExtract：WpfUI/SkiaSharp 类原生库一并收进单文件
      （.NET 9 默认已收原生库，此开关显式写明意图，防 SDK 行为变化）。
    - DebugType=none：发布物只出一个 exe，不带 .pdb（交付物干净）。
    - 该文件只约束发布，不影响日常 build/test。
-->
<Project>
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    引用项目（GitHarvest.Core）不认本文件的 DebugType（pubxml 属性不作为全局属性传导给
    ProjectReference 构建），会在 publish 目录留下它的 .pdb——发布物只应有一个 exe，删掉。
  -->
  <Target Name="RemoveReferencedProjectPdbs" AfterTargets="Publish">
    <ItemGroup>
      <_PdbsToDelete Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PdbsToDelete)" />
  </Target>
</Project>
