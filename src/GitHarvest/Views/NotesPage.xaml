<Page
    x:Class="GitHarvest.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GitHarvest.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        更新说明页（工作流第 4 步）：导出链路（ticket 09）+ 说明编辑器（ticket 10）。
        布局对齐原型：标题行（右侧「重置为模板」）+ 步骤条 + 导出状态卡（原型页 4 的 done-hero）
        + 更新包结构卡 + 双栏编辑器卡（原型页 3 的 .editor-wrap：工具栏 + 左编辑右预览）
        + 页脚（更新日期目录与输出路径，右侧是「上一步 / 开始导出」）。
        工具栏的占位符插入与 B/I/代码/列表是「在光标处动文本」的视图操作，全部在代码后置完成；
        导出中显示进度条与取消；冲突、空范围、失败、取消各有自己的呈现。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageLayout}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding Shell.CurrentTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitleText}" Text="由默认模板生成，导出前可编辑；将随更新包一同输出为「更新说明.md」。" />
                    </StackPanel>
                    <!-- 原型标题行右侧的 subtle 按钮：丢弃编辑、恢复为按当前范围生成的草稿 -->
                    <ui:Button
                        Grid.Column="1"
                        Padding="10,6"
                        VerticalAlignment="Top"
                        Command="{Binding ResetToTemplateCommand}"
                        Style="{StaticResource AppSubtleButton}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Symbol="ArrowClockwise24" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Text="重置为模板" />
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <controls:StepBar Margin="0,20,0,22" DataContext="{Binding Shell}" />

                <!-- 引导卡：未打开仓库或未选定范围 -->
                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowGuide}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderText}" Text="尚未选定变更范围" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource HintText}"
                            Text="请先在「选择提交」页选定基准提交与 Head 提交，再回到这里导出更新包。" />
                        <ui:Button
                            Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding GoToPickCommitsCommand}"
                            Content="返回：选择提交"
                            Style="{StaticResource AppSecondaryButton}" />
                    </StackPanel>
                </Border>

                <!-- 一次性警告：输出路径落在仓库工作区内（本会话只提示一次，可继续） -->
                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppWarningBanner}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsInsideRepositoryWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Foreground="{DynamicResource AppWarnTextBrush}"
                            Symbol="Warning24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource AppWarningText}" Text="输出路径位于当前仓库的工作区内，更新包会出现在 git status 里；可以继续导出，同一会话内不再提示。" />
                        <StackPanel
                            Grid.Column="2"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding ContinueAfterWarningCommand}"
                                Content="仍然导出"
                                Style="{StaticResource AppPrimaryButton}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding CancelWarningCommand}"
                                Content="取消"
                                Style="{StaticResource AppSecondaryButton}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 文件系统冲突：中止导出并列出完整清单（用户故事 32） -->
                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowConflicts}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource AppDangerBrush}"
                                Symbol="ErrorCircle24" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource SectionHeaderText}"
                                Text="发现文件系统冲突，已中止导出" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource HintText}"
                            Text="下列路径无法在 Windows 上安全写出（或会互相覆盖）；请先在仓库里处理，再重新导出。" />

                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Conflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,6"
                                        Padding="12,9"
                                        Background="{DynamicResource AppDangerSoftBrush}"
                                        CornerRadius="6">
                                        <TextBlock Style="{StaticResource AppBannerText}" Text="{Binding Description}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 导出状态卡（原型页 4 的 done-hero：图标 + 标题 + 副文案 + 进度条 + 状态 chip） -->
                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowStatus}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Top"
                            CornerRadius="22">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource AppAccentSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                            <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                            <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Symbol="Save24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding StatusTitle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource HintText}"
                                Text="{Binding StatusSubtitle}" />

                            <!-- 进度条（原型 .progress：细圆角轨道 + 强调色填充），只在导出中出现 -->
                            <ProgressBar
                                Margin="0,10,0,0"
                                Height="6"
                                Maximum="100"
                                Value="{Binding ProgressPercent}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid x:Name="PART_Track">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                                        <Border
                                                            x:Name="PART_Indicator"
                                                            HorizontalAlignment="Left"
                                                            Background="{TemplateBinding Foreground}"
                                                            CornerRadius="3" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right" Text="{Binding StatusChip}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource HintText}" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 导出中：取消（Core 会中断 git 进程并清理半成品目录） -->
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding CancelExportCommand}"
                                Content="取消导出">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource AppSecondaryButton}" TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <!-- 导出完成：打开输出文件夹（用户故事 35） -->
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding OpenOutputFolderCommand}"
                                Content="打开输出文件夹">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource AppPrimaryButton}" TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowOpenOutputFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 更新包结构卡（原型页 4 的「更新包结构」）：固定含两个快照文件夹与更新说明 -->
                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasStructure}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource SectionHeaderText}"
                                Text="更新包结构" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource HintText}"
                                Text="{Binding FolderName, StringFormat='更新包 / {0}'}" />
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource BodyText}">
                                <Run Text="更新前：" />
                                <Run FontWeight="SemiBold" Text="{Binding BeforeFileCount, Mode=OneWay}" />
                                <Run Text=" 个文件 · 旧版本快照" />
                                <Run Text="{Binding DeletedFileNote, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}">
                                <Run Text="更新后：" />
                                <Run FontWeight="SemiBold" Text="{Binding AfterFileCount, Mode=OneWay}" />
                                <Run Text=" 个文件 · 新版本快照" />
                                <Run Text="{Binding AddedFileNote, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource BodyText}"
                                Text="更新说明.md" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource HintText}"
                                Text="{Binding RangeText, StringFormat='变更范围 {0}；「新增」只进「更新后」，「删除」只进「更新前」'}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 自定义模板读取失败的回退提示（用户故事 38：回退内置并告知） -->
                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppWarningBanner}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTemplateNotice}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Foreground="{DynamicResource AppWarnTextBrush}"
                            Symbol="Warning24" />
                        <TextBlock Style="{StaticResource AppWarningText}" Text="{Binding TemplateNotice}" />
                    </StackPanel>
                </Border>

                <!-- 未知占位符警告（用户故事 39：原样保留并提示可能的笔误） -->
                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppWarningBanner}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPlaceholderWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Foreground="{DynamicResource AppWarnTextBrush}"
                            Symbol="Warning24" />
                        <TextBlock Style="{StaticResource AppWarningText}" Text="{Binding PlaceholderWarning}" />
                    </StackPanel>
                </Border>

                <!--
                    更新说明编辑器（原型页 3 的 .editor-wrap）：工具栏横跨整卡，
                    下面左右两栏——左「编辑（Markdown）」等宽输入、右「预览」实时排版。
                    卡片内边距压成 0，栏间分隔线贴卡缘（原型 gap:0 + border-left）。
                -->
                <Border Margin="0,0,0,16" Padding="0">
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowEditor}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid IsEnabled="{Binding CanEdit}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="430" />
                        </Grid.RowDefinitions>

                        <!-- 工具栏（原型 .ed-toolbar：半透底 + 下分隔线） -->
                        <Border
                            Grid.Row="0"
                            Padding="14,10"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppStrokeBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0">
                            <Grid>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:Button
                                        x:Name="PlaceholderButton"
                                        Height="28"
                                        Padding="10,0"
                                        Click="OnPlaceholderButtonClick"
                                        FontSize="12"
                                        Style="{StaticResource AppSecondaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="插入占位符" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Text="▾" />
                                        </StackPanel>
                                    </ui:Button>
                                    <Popup
                                        x:Name="PlaceholderPopup"
                                        AllowsTransparency="True"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=PlaceholderButton}"
                                        StaysOpen="False">
                                        <Border Width="300" Style="{StaticResource AppComboMenu}">
                                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Placeholders}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- 原型 .ph-item：占位符名（等宽强调色）+ 一句说明 -->
                                                            <Button
                                                                Click="OnPlaceholderItemClick"
                                                                Style="{StaticResource AppComboMenuItem}"
                                                                Tag="{Binding Name}">
                                                                <StackPanel Margin="0,2">
                                                                    <TextBlock
                                                                        FontFamily="{StaticResource AppMonospaceFontFamily}"
                                                                        FontSize="12"
                                                                        Foreground="{StaticResource AppAccentBrush}"
                                                                        Text="{Binding Name, StringFormat={}{{{0}}}}" />
                                                                    <TextBlock
                                                                        Margin="0,1,0,0"
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                        Text="{Binding Description}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>

                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        Click="OnBoldClick"
                                        Content="B"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Style="{StaticResource AppSubtleButton}" />
                                    <ui:Button
                                        Padding="10,0"
                                        Click="OnItalicClick"
                                        Content="I"
                                        FontSize="12"
                                        FontStyle="Italic"
                                        Style="{StaticResource AppSubtleButton}" />
                                    <ui:Button
                                        Padding="10,0"
                                        Click="OnCodeClick"
                                        Content="&lt;/&gt;"
                                        FontFamily="{StaticResource AppMonospaceFontFamily}"
                                        FontSize="12"
                                        Style="{StaticResource AppSubtleButton}" />
                                    <ui:Button
                                        Padding="10,0"
                                        Click="OnListClick"
                                        Content="≡ 列表"
                                        FontSize="12"
                                        Style="{StaticResource AppSubtleButton}" />
                                </StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding PlaceholderToolbarHint}" />
                            </Grid>
                        </Border>

                        <!-- 左右双栏（原型 .ed-col：栏头 + 内容，右栏带左分隔线；固定 430 高对齐原型 min-height） -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="0"
                                    Padding="16,9"
                                    BorderBrush="{DynamicResource AppStrokeBrush}"
                                    BorderThickness="0,0,0,1">
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="编辑（Markdown）" />
                                </Border>
                                <!--
                                    无边框等宽编辑框（原型 textarea：透明底、不折行、resize:none）。
                                    用原生 TextBox 而不是 ui:TextBox——后者模板自带描边与图标位，还原不了无边框形态。
                                    滚轮自留（PreviewMouseWheel）：编辑框到顶/底后 WPF 会把滚轮事件放行给页面，
                                    鼠标停在这一栏却把整页滚走；这里显式接管，与右栏预览保持同一体感。
                                -->
                                <TextBox
                                    x:Name="EditorBox"
                                    Grid.Row="1"
                                    Padding="18,14"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FocusVisualStyle="{x:Null}"
                                    FontFamily="{StaticResource AppMonospaceFontFamily}"
                                    FontSize="12.5"
                                    PreviewMouseWheel="OnPanePreviewMouseWheel"
                                    SpellCheck.IsEnabled="False"
                                    Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="NoWrap" />
                            </Grid>

                            <Border
                                Grid.Column="1"
                                BorderBrush="{DynamicResource AppStrokeBrush}"
                                BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Padding="16,9"
                                        BorderBrush="{DynamicResource AppStrokeBrush}"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="预览" />
                                    </Border>
                                    <!-- 预览栏同样自留滚轮：两栏「谁的滚轮谁滚」，不牵连整页 -->
                                    <ScrollViewer
                                        x:Name="PreviewScroll"
                                        Grid.Row="1"
                                        Padding="20,14"
                                        PreviewMouseWheel="OnPanePreviewMouseWheel"
                                        VerticalScrollBarVisibility="Auto">
                                        <controls:MarkdownPreviewView
                                            Blocks="{Binding PreviewBlocks}"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 完成提示浮层（用户故事 35：看到提示并可一键打开输出目录） -->
        <Border
            Grid.RowSpan="2"
            Background="#66000000"
            Visibility="{Binding ShowCompletionPrompt, Converter={StaticResource AppBooleanToVisibilityConverter}}">
            <Border
                Width="560"
                Padding="26,24"
                HorizontalAlignment="Center"
                Style="{StaticResource AppCard}"
                VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AppSuccessSoftBrush}"
                            CornerRadius="20">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{DynamicResource AppSuccessBrush}"
                                Symbol="Checkmark24" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="更新包导出完成" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource HintText}"
                                Text="{Binding StatusSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding OpenOutputFolderCommand}"
                            Content="打开输出文件夹"
                            Style="{StaticResource AppPrimaryButton}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding DismissCompletionPromptCommand}"
                            Content="关闭"
                            Style="{StaticResource AppSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <controls:WorkflowFooter
            Grid.Row="1"
            Margin="30,0,30,26"
            DataContext="{Binding Shell}">
            <controls:WorkflowFooter.LeftContent>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource AppAccentBrush}"
                        Symbol="Folder24" />

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="更新日期目录" />
                            <ui:TextBox
                                Width="170"
                                Margin="8,0,0,0"
                                Padding="10,5,10,5"
                                VerticalContentAlignment="Center"
                                FocusVisualStyle="{x:Null}"
                                FontSize="13"
                                Text="{Binding DataContext.FolderName, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="ui:TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsExporting, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:TextBox.Style>
                            </ui:TextBox>
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="· 输出至（按仓库记住）" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource AppDangerBrush}"
                                Text="{Binding DataContext.FolderNameError, RelativeSource={RelativeSource AncestorType=Page}}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            MaxWidth="420"
                            Style="{StaticResource MonospaceText}"
                            Text="{Binding DataContext.OutputPathDisplay, RelativeSource={RelativeSource AncestorType=Page}}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </controls:WorkflowFooter.LeftContent>
        </controls:WorkflowFooter>
    </Grid>
</Page>
