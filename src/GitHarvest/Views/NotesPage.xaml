<Page
    x:Class="GitHarvest.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GitHarvest.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageLayout}">

            <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding CurrentTitle}" />
            <TextBlock Style="{StaticResource PageSubtitleText}" Text="编辑本次交付的更新说明，然后导出更新包。" />

            <controls:StepBar Margin="0,20,0,20" />

            <ui:Card Style="{StaticResource AppCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderText}" Text="骨架占位" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource HintText}"
                        Text="本页尚无业务功能。计划落地内容：默认模板生成的更新说明、左右双栏实时预览、占位符插入与「重置为模板」，以及最终导出更新包（ticket 09、10）。" />
                </StackPanel>
            </ui:Card>

            <controls:WorkflowFooter />

        </StackPanel>
    </ScrollViewer>
</Page>
