<Page
    x:Class="GitHarvest.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 关于页（并列工具页，不在四步工作流上）。本 ticket 只放骨架占位，业务在 ticket 12 落地。 -->

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageLayout}">

            <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding CurrentTitle}" />
            <TextBlock Style="{StaticResource PageSubtitleText}" Text="应用版本、git 版本与作者信息。" />

            <Border Margin="0,20,0,0" Style="{StaticResource AppCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderText}" Text="骨架占位" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource HintText}"
                        Text="本页尚无内容。计划落地内容：应用版本、探测到的 git 版本与作者信息（ticket 12）。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
