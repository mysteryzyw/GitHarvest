<Page
    x:Class="GitHarvest.Views.RepositoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GitHarvest.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageLayout}">

            <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding CurrentTitle}" />
            <TextBlock Style="{StaticResource PageSubtitleText}" Text="选中本地 Git 仓库后，从这里开始选定提交并导出更新包。" />

            <controls:StepBar Margin="0,20,0,20" />

            <ui:Card Style="{StaticResource AppCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderText}" Text="骨架占位" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource HintText}"
                        Text="本页尚无业务功能。计划落地内容：文件夹选择器打开本地仓库、非仓库目录与提交数不足的明确提示、最近打开的 10 个仓库列表与首次启动引导（ticket 04）。" />
                </StackPanel>
            </ui:Card>

            <controls:WorkflowFooter />

        </StackPanel>
    </ScrollViewer>
</Page>
