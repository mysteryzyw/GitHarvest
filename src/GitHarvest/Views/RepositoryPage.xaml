<Page
    x:Class="GitHarvest.Views.RepositoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        仓库页（工作流第 1 步）。原型里这一页是「欢迎 / 打开仓库」的首屏，既不带步骤指示条也不带底部操作条
        （首屏靠 hero 区与最近仓库卡片前进，ticket 04 落地），本页对齐这一点。
        本 ticket 只加一件事：git 环境自检失败时的引导横幅（含直接去设置页的入口），
        探测成功时横幅收起——首页不需要为正常状态加任何东西。
    -->

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageLayout}">

            <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding Shell.CurrentTitle}" />
            <TextBlock Style="{StaticResource PageSubtitleText}" Text="选定两次提交，导出变更文件快照与更新说明，一键生成交付给客户的更新包。" />

            <Border Margin="0,20,0,0">
                <Border.Style>
                    <Style BasedOn="{StaticResource AppErrorBanner}" TargetType="Border">
                        <Style.Triggers>
                            <!-- 探测完成且 git 不可用时才出现；未探测完（GitStatus 为空）也不闪一下 -->
                            <DataTrigger Binding="{Binding IsGitUnavailable}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource AppDangerBrush}"
                        Symbol="ErrorCircle24" />

                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource AppBannerText}"
                        Text="{Binding GitGuidance}" />

                    <StackPanel
                        Grid.Column="2"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding RefreshGitEnvironmentCommand}"
                            Content="重新检测"
                            Style="{StaticResource AppSecondaryButton}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding OpenSettingsCommand}"
                            Content="前往全局设置"
                            Style="{StaticResource AppPrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,20,0,0" Style="{StaticResource AppCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderText}" Text="骨架占位" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource HintText}"
                        Text="本页尚无业务功能。计划落地内容：文件夹选择器打开本地仓库、非仓库目录与提交数不足的明确提示、最近打开的 10 个仓库列表与首次启动引导（ticket 04）。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
