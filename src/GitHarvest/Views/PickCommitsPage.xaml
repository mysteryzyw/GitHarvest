<Page
    x:Class="GitHarvest.Views.PickCommitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GitHarvest.Controls">

    <!-- 选择提交页（工作流第 2 步）。本 ticket 只放骨架占位，业务在 ticket 06、07 落地。 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageLayout}">

                <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding CurrentTitle}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Text="选定基准提交与 Head 提交，确定变更范围（base..head）。" />

                <controls:StepBar Margin="0,20,0,22" />

                <Border Style="{StaticResource AppCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderText}" Text="骨架占位" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource HintText}"
                            Text="本页尚无业务功能。计划落地内容：本地与远程分支分组列表（带过滤与「拉取」）、提交列表（虚拟化 + 滚动增量加载 + 搜索）、提交完整预览，以及基准必须是 Head 祖先的强制校验（ticket 06、07）。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <controls:WorkflowFooter Grid.Row="1" Margin="30,0,30,26" />
    </Grid>
</Page>
