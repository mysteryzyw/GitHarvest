<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        应用自有的排版与控件样式，视觉取自 docs/prototype/ui-fluent/index.html。
        这里的样式都只描述外观，不含任何业务语义。
    -->

    <!-- ==================== 排版 ==================== -->

    <!-- 页面标题（原型 .page-title：24px / 600 / 字距 -.01em） -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 页面副标题（原型 .page-sub：13px / 距标题 6px） -->
    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- 卡片内的小节标题 -->
    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 正文 -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 弱化提示文字 -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 等宽正文（路径、哈希） -->
    <Style x:Key="MonospaceText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonospaceFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==================== 卡片（原型 .card / .card.pad） ==================== -->
    <!--
        原型卡片是「近白半透明底 + 6% 黑描边 + 8px 圆角 + 柔和投影」。
        WpfUI 的 ui:Card 不提供 CornerRadius 与 Effect，无法还原圆角与投影，
        因此这里用 Border 直接描述卡片外观；需要悬浮反馈的卡片再叠加 hoverable 触发器。
    -->
    <Style x:Key="AppCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Effect" Value="{StaticResource AppCardShadowEffect}" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ==================== 按钮（原型 .btn） ==================== -->
    <!--
        原型 .btn：高 32 / 圆角 4 / 字号 13 / 左右内边距 14。
        必须 BasedOn WpfUI 的隐式按钮样式：一旦给控件显式设置 Style，隐式样式就不再参与，
        按钮会退化成 WPF 自带的灰色方块（Background #DDDDDD）。
    -->
    <Style
        x:Key="AppButtonBase"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <Style
        x:Key="AppPrimaryButton"
        BasedOn="{StaticResource AppButtonBase}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Primary" />
    </Style>

    <Style
        x:Key="AppSecondaryButton"
        BasedOn="{StaticResource AppButtonBase}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Secondary" />
    </Style>

    <!--
        幽灵按钮（原型 .btn.subtle：透明无边框、文字次级色；悬停 5% 黑底 + 文字转主色，按下再深一层）。
        WpfUI 的 Appearance="Transparent" 在悬停时仍会画出白底 + 描边的按钮盒，与原型不符，
        因此这里换成自写模板——模板只认 Background/Foreground，不受 WpfUI 外观画刷影响。
        Focusable=False：该按钮与整卡点击完全等价，且平时不可见（悬停才浮出），不参与键盘导航。
    -->
    <Style
        x:Key="AppSubtleButton"
        BasedOn="{StaticResource AppButtonBase}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Button}">
                    <Border
                        x:Name="Chrome"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0D000000" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#14000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 浮起操作条（原型 .range-bar） ==================== -->
    <!-- 原型：padding 13px 18px / 圆角 10 / 1px 描边 / 0 8px 24px 投影 -->
    <Style x:Key="AppActionBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,13" />
        <Setter Property="Effect" Value="{StaticResource AppBarShadowEffect}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ==================== 页面容器 ==================== -->
    <!-- 原型 .content 的留白为上 26 / 左右 30 / 下 96（底部留白同时给浮起的操作条让位） -->
    <Style x:Key="PageLayout" TargetType="StackPanel">
        <Setter Property="Margin" Value="30,26,30,96" />
    </Style>

    <!-- ==================== 提示横幅（原型 .banner） ==================== -->
    <!--
        原型 .banner.err：11px 14px 内边距、8px 圆角、err-bg 底 + 25% err 描边、正文 13px 深红。
        横幅显示与否由使用它的页面用 DataTrigger 决定（可见性属于页面语义，不在样式里）。
    -->
    <Style x:Key="AppErrorBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 横幅正文（原型 .banner 的 13px） -->
    <Style x:Key="AppBannerText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource AppDangerTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================== 打开仓库拖放区（原型 .drop-zone） ==================== -->
    <!--
        Border 控件不支持虚线边框，虚线由叠加在其上的 Rectangle（AppDropZoneOutline）画出来；
        原型底色 accent-soft = rgba(0,103,192,.10)，悬停加深到 accent-soft-2 = .16。
        这里不设 Padding：内边距必须给在内容侧（见 RepositoryPage），虚线框才能贴着蓝色区域的
        边缘画——原型的 border 就在元素边缘，padding 在边框内侧。
    -->
    <Style x:Key="AppDropZone" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#290067C0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppDropZoneOutline" TargetType="Rectangle">
        <Setter Property="Stroke" Value="#660067C0" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeDashArray" Value="4 3" />
        <Setter Property="RadiusX" Value="10" />
        <Setter Property="RadiusY" Value="10" />
        <!-- 虚线框只负责画线，点击交给外层 Border -->
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <!-- 原型 .drop-zone:hover 时虚线描边变为实色强调色（border-color: accent） -->
            <DataTrigger
                Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                Value="True">
                <Setter Property="Stroke" Value="{StaticResource AppAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== 等宽小徽章（原型 .chip.mono：分支名、路径片段） ==================== -->
    <!-- 原型 .chip：高 24px、左右内边距 10、圆角 12；文字垂直居中交给 AppMonoChipText -->
    <Style x:Key="AppMonoChip" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="#FFEFEFEF" />
        <Setter Property="BorderBrush" Value="{StaticResource AppStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AppMonoChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonospaceFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <!-- 原型 .chip.mono：字重 500 -->
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 最近仓库卡片的图标底（原型 .repo-card .repo-ico：135° 渐变；蓝 / 紫 / 绿按列表序号轮换） -->
    <LinearGradientBrush x:Key="AppRepoIconBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AppAccentColor}" />
        <GradientStop Offset="1" Color="#FF3B9DF0" />
    </LinearGradientBrush>

    <!-- 原型第二张示例卡的紫色渐变 -->
    <LinearGradientBrush x:Key="AppRepoIconPurpleBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF7A3FBF" />
        <GradientStop Offset="1" Color="#FFA972E8" />
    </LinearGradientBrush>

    <!-- 原型第三张示例卡的绿色渐变 -->
    <LinearGradientBrush x:Key="AppRepoIconGreenBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF107C10" />
        <GradientStop Offset="1" Color="#FF4CBF4C" />
    </LinearGradientBrush>

    <!-- 警告横幅（与 AppErrorBanner 同构：11px 14px 内边距、8px 圆角、warn 底 + 25% 描边） -->
    <Style x:Key="AppWarningBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppWarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppWarnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AppWarningText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource AppWarnTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        最近仓库卡片（原型 .repo-card：上下 16 左右 18 内边距）。
        悬停对齐原型 .card.hoverable:hover 的三件事：描边转 25% 强调色、
        投影换成更大的 hover 投影、整卡上浮 1px（0.15s 过渡，与原型 transition 一致）。
    -->
    <Style x:Key="AppRecentRepoCard" TargetType="Border" BasedOn="{StaticResource AppCard}">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#400067C0" />
                <Setter Property="Effect" Value="{StaticResource AppCardHoverShadowEffect}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                To="-1"
                                Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                To="0"
                                Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 成功横幅（与 AppErrorBanner 同构：ok 底 + 25% ok 描边，原型 .banner.ok） -->
    <Style x:Key="AppSuccessBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppSuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="#40107C10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AppSuccessText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="#FF0B5D0B" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================== 分支下拉（原型 .combobox / .combo-menu / .combo-item） ==================== -->
    <!--
        原型 .combobox：高 32、padding 0 10 0 12、control 底色、1px 描边（底边更深）、圆角 4、
        悬停白底。WpfUI 没有对应控件，用 ToggleButton 自写模板（IsChecked 驱动 Popup 开合）。
        底边单独画一条深色边：Fluent 输入控件族的特征（与 .textbox 的 border-bottom 一致）。
    -->
    <Style x:Key="AppComboBoxButton" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0,10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Chrome"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Border
                                Height="1"
                                Margin="1,0"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        下拉菜单卡片（原型 .combo-menu：#FDFDFD 底、1px 卡描边、圆角 8、0 12 28 .16 投影）。
        内边距取 6（原型 4）：菜单里有输入控件，聚焦外框与描边需要一点余量，贴边会被看成被裁切。
        投影复用浮起操作条的 AppBarShadowEffect（同为「浮在页面上方」语义）。
    -->
    <Style x:Key="AppComboMenu" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppRaisedCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Effect" Value="{StaticResource AppBarShadowEffect}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        菜单项（原型 .combo-item：padding 7 10、圆角 4、悬停 8% 强调色底）。
        内容是两行（名称 + 摘要），由页面 DataTemplate 提供，模板只管外壳与悬停。
    -->
    <Style x:Key="AppComboMenuItem" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Background="Transparent"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#140067C0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 组标题（「本地分支」「远程分支」：11px 三级色，原型无此元素，取 .combo-item .sub 同族规格） -->
    <Style x:Key="AppComboGroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Margin" Value="10,8,10,4" />
    </Style>

    <!-- ==================== 左侧导航项（原型 .nav-item） ==================== -->
    <!--
        WpfUI 自带的项模板（NavigationViewCompact.xaml 的 LeftCompactNavigationViewItemTemplate）
        与原型差异较大：选中态是 6% 灰底而非白色卡片、图标不变强调色、没有序号。
        这里用自写模板替换，通过 NavigationView.ItemTemplate 注入。
        序号从项的 Tag 取（原型每项右侧的灰色 1–4），Tag 未被 WpfUI 占用。
    -->
    <ControlTemplate x:Key="AppNavigationViewItemTemplate" TargetType="{x:Type ui:NavigationViewItem}">
        <Grid>
            <Border
                x:Name="ItemBorder"
                MinHeight="37"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="{StaticResource NavItemCornerRadius}"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标：原型 17px、距左边 12px、距文字 12px -->
                    <ContentPresenter
                        x:Name="IconPresenter"
                        Grid.Column="0"
                        Margin="11,0,12,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Icon}"
                        TextElement.FontSize="17"
                        TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- 标题 -->
                    <ContentPresenter
                        x:Name="ElementContentPresenter"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        RecognizesAccessKey="True"
                        TextElement.FontFamily="{StaticResource AppFontFamily}"
                        TextElement.FontSize="13.5"
                        TextElement.Foreground="{TemplateBinding Foreground}" />

                    <!-- 工作流步骤序号（原型 .nav-item .tag） -->
                    <TextBlock
                        x:Name="OrdinalText"
                        Grid.Column="2"
                        Margin="8,0,11,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Grid>
            </Border>

            <!-- 选中态左侧强调竖条：原型 3×18、圆角 2、贴左边缘 -->
            <Rectangle
                x:Name="ActiveIndicator"
                Width="3"
                Height="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Fill="{StaticResource AppAccentBrush}"
                Opacity="0"
                RadiusX="2"
                RadiusY="2" />
        </Grid>

        <ControlTemplate.Triggers>
            <!-- 选中：白色卡片观感（底 + 描边 + 投影）、图标转强调色、标题加粗 -->
            <Trigger Property="IsActive" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AppNavItemActiveBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
                <Setter TargetName="ItemBorder" Property="Effect" Value="{StaticResource AppCardShadowEffect}" />
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{StaticResource AppAccentBrush}" />
                <Setter TargetName="ElementContentPresenter" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>

            <!-- 悬停：仅未选中项加浅灰底 -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AppNavItemHoverBrush}" />
            </MultiTrigger>

            <!-- 按下：在悬停底基础上再压深一层 -->
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
