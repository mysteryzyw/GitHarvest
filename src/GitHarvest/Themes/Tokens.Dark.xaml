<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        随主题变化的令牌——深色一档。键必须与 Tokens.Light.xaml 完全一致（含顺序），
        切换主题时 ThemeService 整体替换本字典。

        取值口径（原型只有浅色稿，深色没有可逐像素对齐的基准，因此按 Fluent 深色规则推导）：
        - 强调色与类型色的**主色**抬亮到深底上仍有对比度（沿用 Windows 11 Fluent 深色调色板的同族取值）；
        - **浅底色**（soft）改为同色 18% 覆盖，叠在深色卡面上形成同族的淡色块；
        - 「正文色比主色更深」的浅色规则在深色档要反过来：用主色本身（深色档里它就是亮色）；
        - 卡面与描边按 Fluent 深色的层叠关系取（卡片 #202020 比窗口底 #1F1F1F 略亮、嵌套卡再亮一级，
          描边用 8% 白），与浅色档「卡片比页面亮」的相对关系保持一致；
        - 「悬停 = 叠一层淡色」的叠加色必须从黑换成白，否则在深底上完全看不见；
        - 文字色不改：全部走 WpfUI 的 TextFillColor* 画刷，随 WpfUI 主题自动切换。
    -->

    <!-- 标记键（与 Tokens.Light.xaml 同一约定）：ThemeService 靠它在 MergedDictionaries 里定位本字典。 -->
    <sys:String x:Key="AppThemeTokensVariant">Dark</sys:String>

    <!-- ==================== 状态色 ==================== -->
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#2E6CCB5F" />
    <SolidColorBrush x:Key="AppSuccessTextBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#2EFF99A4" />
    <SolidColorBrush x:Key="AppDangerTextBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="AppWarnBrush" Color="#FFFCE100" />
    <SolidColorBrush x:Key="AppWarnSoftBrush" Color="#2EFCE100" />
    <SolidColorBrush x:Key="AppWarnTextBrush" Color="#FFFCE100" />

    <!-- ==================== 变更类型五色 ==================== -->
    <SolidColorBrush x:Key="AppTypeAddBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="AppTypeAddSoftBrush" Color="#2E6CCB5F" />
    <SolidColorBrush x:Key="AppTypeDeleteBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="AppTypeDeleteSoftBrush" Color="#2EFF99A4" />
    <SolidColorBrush x:Key="AppTypeModifyBrush" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="AppTypeModifySoftBrush" Color="#2E4CC2FF" />
    <SolidColorBrush x:Key="AppTypeRenameBrush" Color="#FFB18CFF" />
    <SolidColorBrush x:Key="AppTypeRenameSoftBrush" Color="#2EB18CFF" />
    <SolidColorBrush x:Key="AppTypeOtherBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="AppTypeOtherSoftBrush" Color="#1FA0A0A0" />

    <!-- ==================== 中性色 ==================== -->
    <SolidColorBrush x:Key="AppStrokeBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppStrokeStrongBrush" Color="#8AFFFFFF" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#CC202020" />
    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppNeutralBadgeBrush" Color="#FFA0A0A0" />

    <!-- ==================== 卡片与浮起操作条 ==================== -->
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="AppRaisedCardBackgroundBrush" Color="#FF282828" />
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppBarBackgroundBrush" Color="#FF2B2B2B" />

    <!-- ==================== 交互叠加（悬停 / 按下） ==================== -->
    <SolidColorBrush x:Key="AppHoverOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppGhostHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppGhostPressedBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AppHoverBorderBrush" Color="#33FFFFFF" />

    <!-- ==================== 等宽小徽章 ==================== -->
    <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#FF2A2A2A" />

    <!-- ==================== 导航区与窗口底色 ==================== -->
    <!-- 深色下导航区不再铺白：改成一层极淡的白（比内容区略亮），选中项用更亮的卡面 -->
    <SolidColorBrush x:Key="AppNavItemHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="AppNavItemActiveBrush" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="AppNavPaneBackgroundBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="AppTitleBarBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#DB1F1F1F" />

    <!-- ==================== 步骤指示条 ==================== -->
    <SolidColorBrush x:Key="AppStepBadgeBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="AppStepLineBrush" Color="#FF3F3F3F" />

    <!-- ==================== 设置页：行分隔线与分段控件 ==================== -->
    <SolidColorBrush x:Key="AppDividerBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppSegBackgroundBrush" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="AppSegSelectedBrush" Color="#FF3A3A3A" />

    <!-- ==================== 预览页分组卡的卡头 ==================== -->
    <SolidColorBrush x:Key="AppGroupHeadBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppGroupHeadHoverBrush" Color="#1FFFFFFF" />

    <!-- ==================== 提交栏页签 ==================== -->
    <SolidColorBrush x:Key="AppTabSelectedBrush" Color="#FF2E2E2E" />

</ResourceDictionary>
