<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GitHarvest</RootNamespace>
    <AssemblyName>GitHarvest</AssemblyName>
    <!-- 应用清单：声明长路径支持（ticket 09 的验收项）。文件里刻意只加 longPathAware，理由见其注释。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.20" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitHarvest.Core\GitHarvest.Core.csproj" />
  </ItemGroup>

</Project>
