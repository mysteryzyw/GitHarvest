<ui:FluentWindow
    x:Class="GitHarvest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:GitHarvest.Views"
    Title="GitHarvest"
    Width="1280"
    Height="840"
    MinWidth="1000"
    MinHeight="640"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <!--
        应用外壳：标题栏在上，其下是左侧导航（四步工作流 + 全局设置 / 关于）与内容区。
        导航项必须在 XAML 中声明：WpfUI 只在导航控件初始化时登记菜单项，
        之后再添加的项不会被登记，左侧选中态就会与内容区不同步。
        导航标题与 Core 的导航目录（NavigationCatalog）保持一致——后者是步骤指示条与页面标题的真相源，
        页面类型与目的地的对应关系登记在 ShellPageRegistry。
        导航项的 Tag 是原型里 1–4 的步骤序号，只用于显示，不参与任何导航语义。
        根容器的底色是原型 .window 的 86% 灰（盖住 Mica 透出的壁纸色），标题栏与内容区共享这层底。

        窗口根上的两处渲染设置：
        - UseLayoutRounding：把布局位置吸附到整像素，边框与分隔线不会落在半像素上被抗锯齿糊掉。
        - TextOptions.TextFormattingMode="Display"：WPF 默认的 Ideal 模式按排版度量摆放字形，
          在 125% / 150% 缩放的实机上文字发虚；Display 模式把字形与步进吸附整像素，界面文字明显更锐利
          （该附加属性沿视觉树继承，设一次即覆盖整个窗口）。
    -->

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏底色：原型在 Mica 上叠 35% 白，让标题栏比内容区更亮一层 -->
        <Rectangle Grid.Row="0" Fill="{DynamicResource AppTitleBarBackgroundBrush}" IsHitTestVisible="False" />

        <ui:TitleBar
            Grid.Row="0"
            Height="40"
            Title="GitHarvest">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Foreground="{StaticResource AppAccentBrush}" Symbol="BranchFork24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--
            窗口底色的染色层：原型 body 在 Mica 底色上叠了三处极淡的径向渐变（蓝 / 紫 / 绿），
            导航区再叠一层 30% 白。放在导航与内容之下，两侧都是透明背景，因此这层会从两侧一起透出。
            导航区宽度 256 = OpenPaneLength（248）+ PaneGrid 的左右外边距 4×2；
            WpfUI 的内容区边框只画内容那一侧，导航区上方的标题栏分割线由这里补齐。
        -->
        <Grid Grid.Row="1" IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource AppBackgroundTintBlueBrush}" />
            <Rectangle Fill="{StaticResource AppBackgroundTintPurpleBrush}" />
            <Rectangle Fill="{StaticResource AppBackgroundTintGreenBrush}" />

            <Rectangle
                Width="256"
                HorizontalAlignment="Left"
                Fill="{DynamicResource AppNavPaneBackgroundBrush}" />

            <Rectangle
                Width="256"
                Height="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{DynamicResource AppStrokeBrush}" />
        </Grid>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsFooterSeparatorVisible="True"
            IsPaneToggleVisible="False"
            IsTopSeparatorVisible="False"
            ItemTemplate="{StaticResource AppNavigationViewItemTemplate}"
            OpenPaneLength="248"
            PaneDisplayMode="Left">

            <ui:NavigationView.MenuItems>

                <ui:NavigationViewItemHeader
                    Margin="12,6,12,10"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="工作流" />

                <ui:NavigationViewItem
                    Margin="8,1"
                    Content="仓库"
                    Tag="1"
                    TargetPageType="{x:Type views:RepositoryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon FontSize="17" Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Margin="8,1"
                    Content="选择提交"
                    Tag="2"
                    TargetPageType="{x:Type views:PickCommitsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon FontSize="17" Symbol="BranchFork24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Margin="8,1"
                    Content="导出前总预览"
                    Tag="3"
                    TargetPageType="{x:Type views:PreviewPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon FontSize="17" Symbol="Eye24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Margin="8,1"
                    Content="更新说明"
                    Tag="4"
                    TargetPageType="{x:Type views:NotesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon FontSize="17" Symbol="DocumentText24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>

                <ui:NavigationViewItem
                    Margin="8,1"
                    Content="全局设置"
                    TargetPageType="{x:Type views:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon FontSize="17" Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Margin="8,1"
                    Content="关于"
                    TargetPageType="{x:Type views:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon FontSize="17" Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
