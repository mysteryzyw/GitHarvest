<UserControl
    x:Class="GitHarvest.Controls.WorkflowFooter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        工作流页脚：原型里浮在内容区底部的操作条（.range-bar）。
        原型操作条的左端放本次操作的上文（变更范围、输出路径等），
        等 ticket 06 / 08 / 09 有了这些信息再往左端加内容；当前只有右端的步进按钮。
        步进语义与可用性仍由 Core 的导航目录决定，本控件只负责外观。
    -->

    <Border Style="{StaticResource AppActionBar}">
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <ui:Button
                Command="{Binding GoPreviousCommand}"
                Content="上一步"
                IsEnabled="{Binding CanGoPrevious}"
                Style="{StaticResource AppSecondaryButton}" />

            <ui:Button
                Margin="8,0,0,0"
                Command="{Binding GoNextCommand}"
                Content="{Binding NextButtonText}"
                IsEnabled="{Binding CanGoNext}"
                Style="{StaticResource AppPrimaryButton}" />

        </StackPanel>
    </Border>
</UserControl>
